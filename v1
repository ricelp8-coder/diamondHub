-- ============================================================================
local UI = DiamondUI
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local lp = Players.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

-- re-running kills the previous copy (an old __namecall hook from an older version needs a rejoin)
local genv = (getgenv and getgenv()) or _G
local runId = os.clock()
genv.cm_run = runId
local function alive() return genv.cm_run == runId end

local MODES = {"Easy", "Normal", "Hard", "Insane"}
local SPEEDS = {1, 1.5, 2}
local TARGETS = {"First", "Last", "Closest", "Strong", "Weak"}
local MAX_UNITS = 15 -- unit cap of the game (Units: x/15)

local cfg = {
    autoSkip = false,
    autoVote = false,
    autoSpeed = false,
    autoPlayAgain = false,
    mode = "Insane",
    speed = 2,
    skipDelay = 2,          -- internal
    playAgainDelay = 0.25,  -- internal (the result screen is answered almost at once)
}

local st = {
    waveOn = false, lastSkipT = 0, curSpeed = nil,
    inVote = false, voted = false, finalShown = false,
}

local R = {}
local mc = {
    ok = false, hook = false,
    rec = false, play = false, playing = false, running = false,
    replay = "Money", selected = nil,
    wave = 0, matchId = 0, ranMatch = nil, stepNo = 0,
    steps = {}, queue = {}, pend = {},
    id2pos = {}, id2mode = {},
    waitPlace = nil, waitPlaceOk = false, placeFail = nil, upFail = false, upAck = {},
    initDone = false, finalSeen = false,
}
-- ctx is what the (install-once) hook reads, so re-runs never stack hooks
local ctx = {mc = mc, R = R, mv = nil}
genv.cm_cur = ctx

local MAC = UI.MakeStore("CameramanTD/Macros", "cm_mac_mem")
local sanitize = UI.Sanitize

local Win
local recToggle, playToggle, replayDD, macroDD, nameInput, macroStatus

local function flash(t, kind)
    UI:Notify({Title = "Diamond Hub", Content = t, Duration = 2.5, Type = kind or "Info"})
end

local function setBase(t)
    if Win then Win:SetStatus(t) end
end

-- ===== game helpers =====
local function money()
    local mv = ctx.mv
    return mv and mv.Value or 0
end

local function setSpeed(s)
    if not R.ChangeSpeed then return end
    task.spawn(function()
        pcall(function() R.ChangeSpeed:InvokeServer(s) end)
    end)
end

local function visible(o)
    while o and o ~= game do
        if o:IsA("LayerCollector") and not o.Enabled then return false end
        if o:IsA("GuiObject") and not o.Visible then return false end
        o = o.Parent
    end
    return true
end

-- UI lookups are cached: the detection loop runs five times per second
local uiCache, uiMiss = {}, {}
local function findUI(name)
    local o = uiCache[name]
    if o and o.Parent ~= nil and o:IsDescendantOf(pg) then return o end
    if uiMiss[name] and os.clock() - uiMiss[name] < 0.5 then return nil end
    o = pg:FindFirstChild(name, true)
    uiCache[name] = o
    uiMiss[name] = (o == nil) and os.clock() or nil
    return o
end

local function votingOpen()
    local gv = findUI("GamemodeVoting")
    if not gv then return false end
    return visible(gv:FindFirstChild("MainFrame") or gv)
end

local function finalOpen()
    local f = findUI("FinalUI")
    return f ~= nil and visible(f)
end

-- ===== macro logic =====
local function v2a(v) return {v.X, v.Y, v.Z} end
local function a2v(a) return Vector3.new(a[1], a[2], a[3]) end

local function syncToggles()
    if recToggle then recToggle:Set(mc.rec, true) end
    if playToggle then playToggle:Set(mc.play, true) end
end

local function pushStep(s)
    table.insert(mc.steps, s)
    table.sort(mc.steps, function(a, b) return (a.ts or 0) < (b.ts or 0) end)
end

local function idAt(p)
    local best, bestD
    for id, pos in pairs(mc.id2pos) do
        local d = (pos - p).Magnitude
        if d < 1.5 and (not bestD or d < bestD) then
            best, bestD = id, d
        end
    end
    return best
end

local function ownCount()
    local n = 0
    for _ in pairs(mc.id2pos) do n = n + 1 end
    return n
end

-- hook entries -> pending list (runs outside the hook, so Instance calls are safe here)
local function drainQueue()
    local q = mc.queue
    if #q == 0 then return end
    mc.queue = {}
    for _, e in ipairs(q) do
        if e.k == "TowerAdd" then
            if typeof(e.pos) == "Vector3" then
                table.insert(mc.pend, {k = "place", p = e.pos, u = e.u, n = e.n, m = e.m, w = e.w, ts = e.ts})
            end
        else
            local p = e.id and mc.id2pos[e.id]
            if p then
                table.insert(mc.pend, {
                    k = (e.k == "TowerUpgrade") and "upgrade" or "sell",
                    p = p, id = e.id, m = e.m, w = e.w, ts = e.ts,
                })
            else
                flash("Unknown tower: place towers after the script starts", "Warning")
            end
        end
    end
end

-- upgrades are accepted unless the server complains within ~1.2 s; stale pendings expire
local function tickPend()
    local now = os.clock()
    for i = #mc.pend, 1, -1 do
        local e = mc.pend[i]
        if e.k == "upgrade" and now - e.ts > 1.2 then
            table.remove(mc.pend, i)
            pushStep({t = "upgrade", p = v2a(e.p), m = e.m, w = e.w, ts = e.ts})
        elseif now - e.ts > 6 then
            table.remove(mc.pend, i)
            if e.k == "place" then flash("Placement rejected, not recorded", "Warning") end
        end
    end
end

local function dropLastUpgrade()
    for i = #mc.pend, 1, -1 do
        local e = mc.pend[i]
        if e.k == "upgrade" and os.clock() - e.ts < 2 then
            table.remove(mc.pend, i)
            return
        end
    end
end

-- new match: abort a running macro, reset wave, speed and the tower cache
local function newMatch()
    mc.matchId = mc.matchId + 1
    mc.wave = 0
    mc.id2pos, mc.id2mode, mc.upAck = {}, {}, {}
    mc.pend, mc.queue = {}, {}
    mc.finalSeen = false
    st.curSpeed, st.waveOn = nil, false
    if mc.rec then
        mc.rec = false
        syncToggles()
        flash("Recording stopped: new match")
    end
end

-- result screen: abort a running macro and do not restart it until the next match begins
local function matchEnded()
    if mc.finalSeen then return end
    mc.finalSeen = true
    mc.matchId = mc.matchId + 1
    mc.ranMatch = mc.matchId
end

local function onTowerAdd(t)
    if not alive() or type(t) ~= "table" or not t.Id or t.OwnerUserId ~= lp.UserId then return end
    local pos = t.Pos
    if typeof(pos) ~= "Vector3" then return end

    -- drop stale ids standing at the same spot (leftovers of a previous match)
    for id, p in pairs(mc.id2pos) do
        if id ~= t.Id and (p - pos).Magnitude < 0.5 then
            mc.id2pos[id] = nil
            mc.id2mode[id] = nil
        end
    end
    mc.id2pos[t.Id] = pos
    mc.id2mode[t.Id] = t.TargetMode

    if mc.waitPlace and (pos - mc.waitPlace).Magnitude < 1 then
        mc.waitPlaceOk = true
    end

    if mc.rec and not mc.playing then
        local hit
        for i, e in ipairs(mc.pend) do
            if e.k == "place" and (e.p - pos).Magnitude < 1 then
                hit = i
                break
            end
        end
        if hit then
            local e = table.remove(mc.pend, hit)
            -- cost hint: only trusted when no other action was close in time (money lags behind remotes)
            local c
            local last = mc.steps[#mc.steps]
            if #mc.pend == 0 and (not last or e.ts - (last.ts or 0) > 1.5) then
                local d = (e.m or 0) - money()
                if d > 0 and d <= (e.m or 0) then c = d end
            end
            pushStep({t = "place", p = v2a(pos), u = t.UnitId or e.u, n = t.Name or e.n, m = e.m, c = c, w = e.w, ts = e.ts})
        else
            pushStep({t = "place", p = v2a(pos), u = t.UnitId, n = t.Name, m = money(), w = mc.wave, ts = os.clock()})
        end
    end
end

local function onTowerRemove(t)
    if not alive() or type(t) ~= "table" or not t.Id then return end
    local pos = mc.id2pos[t.Id]
    if pos and mc.rec and not mc.playing then
        for i, e in ipairs(mc.pend) do
            if e.k == "sell" and e.id == t.Id then
                table.remove(mc.pend, i)
                pushStep({t = "sell", p = v2a(pos), m = e.m, w = e.w, ts = e.ts})
                break
            end
        end
    end
    mc.id2pos[t.Id] = nil
    mc.id2mode[t.Id] = nil
end

local function onTowerTarget(t)
    if not alive() or type(t) ~= "table" or not t.Id or not t.TargetMode then return end
    mc.id2mode[t.Id] = t.TargetMode
    local pos = mc.id2pos[t.Id]
    if mc.rec and not mc.playing and pos then
        local last = mc.steps[#mc.steps]
        if last and last.t == "target" and (a2v(last.p) - pos).Magnitude < 0.5 then
            last.mode = t.TargetMode -- collapse a cycle of presses into the final mode
        else
            pushStep({t = "target", p = v2a(pos), mode = t.TargetMode, w = mc.wave, ts = os.clock()})
        end
    end
end

-- the server may answer an upgrade with its own TowerUpgrade event: it confirms the upgrade instantly
local function onTowerUpgrade(t)
    if not alive() or type(t) ~= "table" then return end
    local id = t.Id or t.TowerId
    if id then mc.upAck[id] = os.clock() end
end

local function onNotify(msg)
    if not alive() or type(msg) ~= "string" then return end
    local sp = msg:match("changed the game speed to ([%d%.]+)")
    if sp then
        st.curSpeed = tonumber(sp)
        return
    end
    -- answers to a placement the macro is waiting for
    if mc.waitPlace then
        local low = msg:lower()
        if low:find("enough money", 1, true) then
            mc.placeFail = "money"
        elseif not low:find("successfully placed", 1, true) and (low:find("place", 1, true)
            or low:find("limit", 1, true) or low:find("can't", 1, true) or low:find("cannot", 1, true)) then
            mc.placeFail = "other"
        end
    end
    if msg:find("enough money to upgrade") then
        mc.upFail = true
        dropLastUpgrade()
    elseif msg:find("Wave Cleared") then
        st.waveOn = false
    elseif msg:find("started!") then
        local n = msg:match("Wave (%d+) started")
        if n == "1" and mc.finalSeen then newMatch() end
        st.waveOn = true
        st.lastSkipT = os.clock()
        if n then mc.wave = tonumber(n) end
        if cfg.autoSpeed and st.curSpeed ~= cfg.speed then
            task.delay(1, function()
                if alive() and cfg.autoSpeed then setSpeed(cfg.speed) end
            end)
        end
    end
end

-- The hook must NOT call any Instance method (FindFirstChild, GetAttribute, ...) before calling the
-- original: that overwrites the stored namecall method and the real FireServer then runs as the wrong
-- method. It only reads properties and copies plain values, everything else happens outside.
local function installHook()
    if genv.cm_hooked then return true end
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then return false end
    local wrap = newcclosure or function(f) return f end
    local oldNC
    oldNC = hookmetamethod(game, "__namecall", wrap(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" then
            local c = genv.cm_cur
            if c and c.mc.rec and not c.mc.playing and not (checkcaller and checkcaller()) then
                local rr = c.R
                if self == rr.TowerAdd or self == rr.TowerUpgrade or self == rr.TowerSell then
                    local arg = ...
                    if type(arg) == "table" then
                        local mv = c.mv
                        local q = c.mc.queue
                        q[#q + 1] = {
                            k = self.Name,
                            pos = arg.Pos, id = arg.Id, u = arg.UnitId, n = arg.Name,
                            m = mv and mv.Value or 0,
                            w = c.mc.wave,
                            ts = os.clock(),
                        }
                    end
                end
            end
        end
        return oldNC(self, ...)
    end))
    genv.cm_hooked = true
    return true
end

-- ===== macro playback =====
local function same(myMatch)
    return alive() and mc.play and mc.matchId == myMatch
end

local function sleep(t, myMatch)
    local t0 = os.clock()
    while os.clock() - t0 < t do
        if not same(myMatch) then return false end
        task.wait(0.05)
    end
    return same(myMatch)
end

local function waitUntil(cond, timeout, myMatch, step)
    local t0 = os.clock()
    while same(myMatch) do
        if cond() then return true end
        if os.clock() - t0 > timeout then return false end
        task.wait(step or 0.1)
    end
    return false
end

-- how long to wait for the server's answer to an upgrade (adapts to the connection)
local function upgradeCheck()
    local ok, ping = pcall(function() return lp:GetNetworkPing() end)
    if not ok or type(ping) ~= "number" then ping = 0.1 end
    return math.clamp(ping * 2 + 0.06, 0.12, 0.5)
end

-- after a "not enough money" answer: wait until some income arrived, then the step is retried
local function waitMoreMoney(myMatch)
    local mf, t0 = money(), os.clock()
    return waitUntil(function() return money() > mf and os.clock() - t0 > 0.4 end, math.huge, myMatch, 0.1)
end

-- the unit GUID can differ between accounts/loadouts: resolve it from the current slots by name
local function resolveUnit(name, saved)
    for i = 1, 5 do
        if lp:GetAttribute("Slot" .. i) == name then
            local id = lp:GetAttribute("Slot" .. i .. "Id")
            if id then return id end
        end
    end
    return saved
end

local function doPlace(s, myMatch)
    local p = a2v(s.p)
    if idAt(p) then return true end -- already standing there
    if ownCount() >= MAX_UNITS then
        flash("Unit limit reached (" .. MAX_UNITS .. "), step skipped", "Warning")
        return false
    end
    local unitId = resolveUnit(s.n, s.u)
    local misses = 0
    while same(myMatch) do
        -- known cost: do not fire before it is affordable (capped, the server has the last word)
        if s.c and money() < s.c then
            waitUntil(function() return money() >= s.c end, 20, myMatch, 0.1)
            if not same(myMatch) then return false end
        end
        mc.waitPlace, mc.waitPlaceOk, mc.placeFail = p, false, nil
        R.TowerAdd:FireServer({Pos = p, CFrame = CFrame.new(p), Name = s.n, UnitId = unitId})
        waitUntil(function() return mc.waitPlaceOk or mc.placeFail ~= nil end, 1.2, myMatch, 0.02)
        local ok, fail = mc.waitPlaceOk, mc.placeFail
        mc.waitPlace = nil
        if ok then return true end
        if not same(myMatch) then return false end
        if fail == "money" then
            if not waitMoreMoney(myMatch) then return false end
        else
            misses = misses + 1
            if misses >= 6 then
                flash("Place failed, step skipped", "Warning")
                return false
            end
            if not sleep(0.6, myMatch) then return false end
        end
    end
    return false
end

-- upgrades are fired back to back like fast taps: wait only for the server's answer, not a fixed time
local function doUpgrade(s, myMatch)
    local p = a2v(s.p)
    while same(myMatch) do
        local id = idAt(p)
        if not id then return false end -- nothing standing there (earlier place failed)
        mc.upFail = false
        local before = mc.upAck[id]
        R.TowerUpgrade:FireServer({Id = id})
        -- answer: S->C TowerUpgrade for this tower, a "not enough money" notice, or silence (= accepted)
        waitUntil(function() return mc.upFail or mc.upAck[id] ~= before end, upgradeCheck(), myMatch, 0.02)
        if not same(myMatch) then return false end
        if not mc.upFail then return true end
        if not waitMoreMoney(myMatch) then return false end
    end
    return false
end

local function doSell(s, myMatch)
    local id = idAt(a2v(s.p))
    if not id then return false end
    R.TowerSell:FireServer({Id = id})
    -- wait for the removal so a later place on the same spot does not see the old tower
    waitUntil(function() return mc.id2pos[id] == nil end, 1.5, myMatch, 0.02)
    return same(myMatch)
end

local function doTarget(s, myMatch)
    local id = idAt(a2v(s.p))
    if not id then return false end
    for _ = 1, #TARGETS do
        if mc.id2mode[id] == s.mode then return true end
        local cur = mc.id2mode[id]
        R.TowerTarget:FireServer({Id = id})
        if not waitUntil(function() return mc.id2mode[id] ~= cur end, 1.0, myMatch, 0.02) then
            return false
        end
    end
    return false
end

local function gate(s, myMatch)
    -- sells/target changes always wait for their wave, Wave mode makes everything wait for it.
    -- In Money mode place/upgrade run as soon as the previous step is done and retry until affordable.
    if mc.replay == "Wave" or s.t == "sell" or s.t == "target" then
        if not waitUntil(function() return mc.wave >= (s.w or 0) end, math.huge, myMatch) then return false end
    end
    return same(myMatch)
end

local function runPlayback(myMatch)
    mc.playing = true
    mc.stepNo = 0
    for i, s in ipairs(mc.steps) do
        if not same(myMatch) then break end
        mc.stepNo = i
        if gate(s, myMatch) then
            if s.t == "place" then
                doPlace(s, myMatch)
            elseif s.t == "upgrade" then
                doUpgrade(s, myMatch)
            elseif s.t == "sell" then
                doSell(s, myMatch)
            elseif s.t == "target" then
                doTarget(s, myMatch)
            end
            task.wait(0.02)
        end
    end
    local finished = same(myMatch) and mc.stepNo >= #mc.steps
    mc.playing = false
    if finished then flash("Macro finished, waiting for the next match", "Success") end
end

local function cleanSteps(arr)
    local out = {}
    if type(arr) ~= "table" then return out end
    for _, s in ipairs(arr) do
        if type(s) == "table" and type(s.t) == "string" and type(s.p) == "table"
            and type(s.p[1]) == "number" and type(s.p[2]) == "number" and type(s.p[3]) == "number" then
            table.insert(out, s)
        end
    end
    return out
end

-- ===== saved macros: selecting one loads it, then just press Play =====
local function refreshMacroList()
    if macroDD then macroDD:SetOptions(MAC.list()) end
end

local function loadMacro(name, silent)
    local d = MAC.read(name)
    local steps = d and cleanSteps(d.steps) or {}
    if #steps == 0 then
        if not silent then flash("Macro not found or empty: " .. tostring(name), "Error") end
        return false
    end
    mc.steps = steps
    if d.replay == "Money" or d.replay == "Wave" then
        mc.replay = d.replay
        if replayDD then replayDD:Set(d.replay, true) end
    end
    mc.selected = name
    MAC.setAuto(name) -- remembered: after a rejoin it is already selected
    if macroDD then macroDD:Set(name, true) end
    if nameInput then nameInput:Set(name, true) end
    if not silent then flash("Loaded macro: " .. name .. " (" .. #steps .. " steps)", "Success") end
    return true
end

local function saveMacro()
    local n = sanitize(nameInput:Get())
    if n == "" then
        flash("Enter a macro name first", "Warning")
        return
    end
    if #mc.steps == 0 then
        flash("Nothing to save: record a macro first", "Warning")
        return
    end
    if MAC.write(n, {v = 2, replay = mc.replay, steps = mc.steps}) then
        mc.selected = n
        MAC.setAuto(n)
        refreshMacroList()
        macroDD:Set(n, true)
        flash("Saved macro: " .. n .. " (" .. #mc.steps .. " steps)", "Success")
    else
        flash("Save failed", "Error")
    end
end

local function deleteMacro()
    local n = sanitize(nameInput:Get())
    if n == "" then n = mc.selected or "" end
    if n == "" or not MAC.exists(n) then
        flash("Pick a saved macro to delete", "Warning")
        return
    end
    if MAC.delete(n) then
        if mc.selected == n then
            mc.selected = nil
            MAC.setAuto(nil)
        end
        refreshMacroList()
        macroDD:Set(nil, true)
        flash("Deleted macro: " .. n, "Success")
    else
        flash("Delete failed", "Error")
    end
end

