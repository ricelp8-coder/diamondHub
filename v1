    function Container:AddDivider()
        local win = self.Window
        local d = new("Frame", {Size = UDim2.new(1, 0, 0, 1), BorderSizePixel = 0, LayoutOrder = self:_order()}, self.Frame)
        win:_bind(d, "BackgroundColor3", "Stroke")
