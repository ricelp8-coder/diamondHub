    function Window:AddSettingsTab(name)
        local win = self
        local tab = self:AddTab(name or "Settings")

        local cs = tab:AddSection("Config")
        local nameBox, cfgDD, autoT
        nameBox = cs:AddInput({
            Name = "Config Name", Placeholder = "my config", NoSave = true,
            Callback = function(text)
                autoT:Set(win:GetAutoLoad() == sanitize(text), true)
            end,
        })
        cfgDD = cs:AddDropdown({
            Name = "Saved Configs", Options = win:ListConfigs(), NoSave = true,
            Callback = function(v)
                nameBox:Set(v, true)
                autoT:Set(win:GetAutoLoad() == v, true)
            end,
        })
        local function refresh() cfgDD:SetOptions(win:ListConfigs()) end

        local g = cs:AddGrid({Columns = 3, CellHeight = 34})
        g:AddButton({Name = "Save", Style = "Accent", Callback = function()
            local n = sanitize(nameBox:Get())
            if n == "" then
                Lib:Notify({Title = "Config", Content = "Enter a config name first", Type = "Warning"})
                return
            end
            if win:SaveConfig(n) then
                Lib:Notify({Title = "Config", Content = "Saved: " .. n, Type = "Success"})
            else
                Lib:Notify({Title = "Config", Content = "Save failed", Type = "Error"})
            end
            refresh()
            cfgDD:Set(n, true)
            autoT:Set(win:GetAutoLoad() == n, true)
        end})
        g:AddButton({Name = "Load", Callback = function()
            local n = sanitize(nameBox:Get())
            if n == "" then
                Lib:Notify({Title = "Config", Content = "Enter a config name first", Type = "Warning"})
                return
            end
            if win:LoadConfig(n) then
                Lib:Notify({Title = "Config", Content = "Loaded: " .. n, Type = "Success"})
            else
                Lib:Notify({Title = "Config", Content = "Config not found: " .. n, Type = "Error"})
            end
        end})
        g:AddButton({Name = "Delete", Style = "Danger", Callback = function()
            local n = sanitize(nameBox:Get())
            if n == "" then
                Lib:Notify({Title = "Config", Content = "Enter a config name first", Type = "Warning"})
                return
            end
            if win:DeleteConfig(n) then
                Lib:Notify({Title = "Config", Content = "Deleted: " .. n, Type = "Success"})
            else
                Lib:Notify({Title = "Config", Content = "Config not found: " .. n, Type = "Error"})
            end
            refresh()
            cfgDD:Set(nil, true)
            autoT:Set(false, true)
        end})
        autoT = cs:AddToggle({
            Name = "Auto Load This Config", NoSave = true,
            Tooltip = "Loads this config automatically on start, no button needed",
            Callback = function(on)
                local n = sanitize(nameBox:Get())
                if n == "" then
                    Lib:Notify({Title = "Config", Content = "Enter a config name first", Type = "Warning"})
                    autoT:Set(false, true)
                    return
                end
                if on then
                    if not win.Store.exists(n) then
                        win:SaveConfig(n)
                        refresh()
                    end
                    win:SetAutoLoad(n)
                    Lib:Notify({Title = "Config", Content = "Auto load on: " .. n, Type = "Success"})
                else
                    if win:GetAutoLoad() == n then win:SetAutoLoad(nil) end
                    Lib:Notify({Title = "Config", Content = "Auto load off", Type = "Info"})
                end
            end,
        })
        if not win.Store.hasFS then
            cs:AddLabel("Files are not available in this executor: configs live until you leave the game.")
        end

        local ap = tab:AddSection("Appearance")
        ap:AddDropdown({
            Name = "Theme", Flag = "ui.theme", Options = {"Dark", "Light", "Midnight", "Ocean"},
            Default = win.ThemeName, Searchable = false,
            Callback = function(v) win:SetTheme(v) end,
        })
        win._accentPicker = ap:AddColorPicker({
            Name = "Accent Color", Flag = "ui.accent", Default = win.Theme.Accent,
            Callback = function(c) win:SetAccent(c) end,
        })
        ap:AddSlider({
            Name = "Transparency", Flag = "ui.transparency", Min = 0, Max = 0.6, Step = 0.05, Default = win.Transparency,
            Callback = function(v) win:SetTransparency(v) end,
        })
        ap:AddSlider({
            Name = "UI Scale", Flag = "ui.scale", Min = 0.7, Max = 1.2, Step = 0.05, Default = win.Scale,
            Callback = function(v) win:SetScale(v) end,
        })

        local ct = tab:AddSection("Controls")
        ct:AddToggle({
            Name = "Lock UI", Flag = "ui.lock", Default = false,
            Tooltip = "Disables dragging and resizing the window",
            Callback = function(v) win:SetLocked(v) end,
        })
        ct:AddKeybind({
            Name = "Toggle UI Key", Flag = "ui.key", Default = win.ToggleKey, Mode = "Press",
            Changed = function(k) win.ToggleKey = k or Enum.KeyCode.RightShift end,
        })
        ct:AddButton({Name = "Reset Window Position", Callback = function() win:ResetPosition() end})
        return tab
    end

