local function postWebhook(payload)
    local req = (type(request) == "function" and request)
        or (type(http_request) == "function" and http_request)
        or (type(syn) == "table" and type(syn.request) == "function" and syn.request)
        or (type(fluxus) == "table" and type(fluxus.request) == "function" and fluxus.request)
        or (type(http) == "table" and type(http.request) == "function" and http.request)
    if not req then return false, "no HTTP function in this executor" end
    local body = HttpService:JSONEncode(payload)
    local code, why
    for attempt = 1, 2 do
        local ok, res = pcall(req, {
            Url = WEBHOOK_URL,
            Method = "POST",
            -- some executors send a UA that Cloudflare in front of Discord rejects (403 / error 1010)
            Headers = {["Content-Type"] = "application/json", ["User-Agent"] = "DiamondHub/1.0"},
            Body = body,
        })
        if not ok then return false, tostring(res) end
        code = type(res) == "table" and (res.StatusCode or res.Status) or nil
        if type(code) == "number" and code >= 200 and code < 300 then return true end
        if code == nil and type(res) == "table" and res.Success == true then return true end
        why = type(res) == "table" and type(res.Body) == "string" and res.Body:sub(1, 60) or nil
        if code ~= 429 or attempt == 2 then break end
        task.wait(2)
    end
    warn("[cm] webhook: HTTP " .. tostring(code) .. " " .. tostring(why))
    return false, "HTTP " .. tostring(code) .. (why and (" " .. why) or "")
end

local function fmtDuration(sec)
    if not sec then return "n/a" end
    sec = math.max(0, math.floor(sec))
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local sc = sec % 60
    if h > 0 then return string.format("%d:%02d:%02d", h, m, sc) end
    return string.format("%d:%02d", m, sc)
end

local function fmtNumber(n)
    local digits = tostring(math.floor(n))
    local out = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (out:gsub("^,", ""))
end

local function readFinal()
    local f = findUI("FinalUI")
    if not f then return nil, nil end
    local coins, result
    for _, d in ipairs(f:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            local text = d.Text
            if type(text) == "string" and text ~= "" then
                local low = text:lower()
                if not result then
                    if low:find("won", 1, true) or low:find("victory", 1, true) then
                        result = "Victory"
                    elseif low:find("lost", 1, true) or low:find("defeat", 1, true) or low:find("failed", 1, true) then
                        result = "Defeat"
                    end
                end
                local p, inCoins = d, false
                while p and p ~= f do
                    if p.Name:lower():find("coin", 1, true) then
                        inCoins = true
                        break
                    end
                    p = p.Parent
                end
                if inCoins then
                    for num in text:gmatch("[%d,]+") do
                        local v = tonumber((num:gsub(",", "")))
                        if v and (not coins or v > coins) then coins = v end
                    end
                end
            end
        end
    end
    return coins, result
end

