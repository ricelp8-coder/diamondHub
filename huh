-- price = money before the action minus the lowest balance seen after it; skipped when
-- another action sits within 0.9s, because the drop can't be attributed to one of them
local function priceOf(e, step)
    local drop = (e.m or 0) - (e.lo or e.m or 0)
    if drop <= 0 then return nil end
    local function crowded(list, skip)
        for _, o in ipairs(list) do
            if o ~= skip and o.ts and math.abs(o.ts - e.ts) < 0.9 then return true end
        end
        return false
    end
    if crowded(mc.steps, step) or crowded(mc.pend, e) or crowded(mc.settle, e) or crowded(mc.queue, e) then
        return nil
    end
    return drop
end

local function drainQueue()
