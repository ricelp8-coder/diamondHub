local function onTowerAdd(t)
    if not alive() or type(t) ~= "table" or not t.Id or t.OwnerUserId ~= lp.UserId then return end
    local pos = t.Pos
    if typeof(pos) ~= "Vector3" then return end

    for id, p in pairs(mc.id2pos) do
        if id ~= t.Id and (p - pos).Magnitude < 0.5 then
            mc.id2pos[id] = nil
            mc.id2mode[id] = nil
            mc.id2name[id] = nil
        end
    end
    mc.id2pos[t.Id] = pos
    mc.id2mode[t.Id] = t.TargetMode
    mc.id2name[t.Id] = t.Name

    if mc.waitPlace and (pos - mc.waitPlace).Magnitude < 1 then
        mc.waitPlaceOk = true
    end

    if mc.rec and not mc.playing then
        -- the 0.1s drain loop can lose the race against a fast server ack, so drain here first
        drainQueue()
        local hit, bestD
        for i, e in ipairs(mc.pend) do
            if e.k == "place" then
                local d = (e.p - pos).Magnitude
                if d < 4 and (not bestD or d <= bestD) then hit, bestD = i, d end
            end
        end
        if hit then
            local e = table.remove(mc.pend, hit)
            local step = {t = "place", p = v2a(pos), u = t.UnitId or e.u, n = t.Name or e.n, m = e.m, w = e.w, ts = e.ts}
            pushStep(step)
            table.insert(mc.settle, {ts = e.ts, m = e.m, lo = e.lo, step = step})
        else
            pushStep({t = "place", p = v2a(pos), u = t.UnitId, n = t.Name, m = money(), w = mc.wave, ts = os.clock()})
        end
    end
end

local function onTowerRemove(t)
    if not alive() or type(t) ~= "table" or not t.Id then return end
    -- the sell click may still sit in the 0.1s queue: drain before id2pos is cleared or the sell is lost
    if mc.rec and not mc.playing then drainQueue() end
    local pos = mc.id2pos[t.Id]
    if pos and mc.rec and not mc.playing then
        for i, e in ipairs(mc.pend) do
            if e.k == "sell" and e.id == t.Id then
                table.remove(mc.pend, i)
                pushStep({t = "sell", p = v2a(pos), m = e.m, w = e.w, ts = e.ts})
                break
            end
        end
    end
    mc.id2pos[t.Id] = nil
    mc.id2mode[t.Id] = nil
    mc.id2name[t.Id] = nil
end

local function onTowerTarget(t)
    if not alive() or type(t) ~= "table" or not t.Id or not t.TargetMode then return end
    mc.id2mode[t.Id] = t.TargetMode
    local pos = mc.id2pos[t.Id]
    if mc.rec and not mc.playing and pos then
        local last = mc.steps[#mc.steps]
        if last and last.t == "target" and (a2v(last.p) - pos).Magnitude < 0.5 then
            last.mode = t.TargetMode
        else
            pushStep({t = "target", p = v2a(pos), mode = t.TargetMode, w = mc.wave, ts = os.clock()})
        end
    end
end

local function onTowerUpgrade(t)
    if not alive() or type(t) ~= "table" then return end
    local id = t.Id or t.TowerId
    if not id then return end
    mc.upAck[id] = os.clock()
    if not mc.id2pos[id] then return end
    mc.ackSeen = true
    if mc.rec and not mc.playing then
        drainQueue()
        for _, e in ipairs(mc.pend) do
            if e.k == "upgrade" and e.id == id and not e.ok then
                e.ok = true
                break
            end
        end
    end
end

local function onNotify(msg)
    if not alive() or type(msg) ~= "string" then return end
    local sp = msg:match("changed the game speed to ([%d%.]+)")
    if sp then
        st.curSpeed = tonumber(sp)
        return
    end
    if msg:lower():find("enough money", 1, true) and os.clock() - LB.lastSummon < 3 and not LB.inMatch() then
        LB.stopSummon()
        return
    end
    if mc.waitPlace then
        local low = msg:lower()
        if low:find("enough money", 1, true) then
            mc.placeFail = "money"
        elseif not low:find("successfully placed", 1, true) and (low:find("place", 1, true)
            or low:find("limit", 1, true) or low:find("can't", 1, true) or low:find("cannot", 1, true)) then
            if low:find("limit", 1, true) or low:find("maximum", 1, true) or low:find("only place", 1, true) then
                mc.placeFail = "limit"
            else
                mc.placeFail = "other"
            end
        end
    end
    if msg:find("enough money to upgrade") then
        mc.upFail = true
        dropLastUpgrade()
    elseif msg:find("Wave Cleared") then
        st.waveOn = false
    elseif msg:find("started!") then
        local n = msg:match("Wave (%d+) started")
        if n == "1" and mc.finalSeen then newMatch() end
        if n == "1" then st.matchStart = os.clock() end
        st.waveOn = true
        st.nextSkip = os.clock() + cfg.skipDelay
        if n then mc.wave = tonumber(n) end
        if n == "1" then st.speedTries = 0 end
        if cfg.autoSpeed and st.curSpeed ~= cfg.speed then setSpeed(cfg.speed) end
    end
end

local function installHook()
    if genv.cm_hooked then return true end
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then return false end
    local wrap = newcclosure or function(f) return f end
    local oldNC
    oldNC = hookmetamethod(game, "__namecall", wrap(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" then
            local c = genv.cm_cur
            if c and c.R.ModeVote and self == c.R.ModeVote then
                local voted = ...
                if type(voted) == "string" and voted ~= "" then c.st.matchMode = voted end
            end
            if c and c.mc.rec and not c.mc.playing and not (checkcaller and checkcaller()) then
                local rr = c.R
                if self == rr.TowerAdd or self == rr.TowerUpgrade or self == rr.TowerSell then
                    local arg = ...
                    if type(arg) == "table" then
                        local mv = c.mv
                        local q = c.mc.queue
                        q[#q + 1] = {
                            k = self.Name,
                            pos = arg.Pos, id = arg.Id, u = arg.UnitId, n = arg.Name,
                            m = mv and mv.Value or 0,
                            lo = mv and mv.Value or 0,
                            w = c.mc.wave,
                            ts = os.clock(),
                        }
                    end
                end
            end
        end
        return oldNC(self, ...)
    end))
    genv.cm_hooked = true
    return true
end

local function same(myMatch)
    return alive() and mc.play and mc.matchId == myMatch
end

local function sleep(t, myMatch)
    local t0 = os.clock()
    while os.clock() - t0 < t do
        if not same(myMatch) then return false end
        task.wait(0.05)
    end
    return same(myMatch)
end

local function waitUntil(cond, timeout, myMatch, step)
    local t0 = os.clock()
    while same(myMatch) do
        if cond() then return true end
        if os.clock() - t0 > timeout then return false end
        task.wait(step or 0.1)
    end
    return false
end

local function resolveUnit(name, saved)
    for i = 1, 5 do
        if lp:GetAttribute("Slot" .. i) == name then
            local id = lp:GetAttribute("Slot" .. i .. "Id")
            if id then return id end
        end
    end
    return saved
end

local function limitFor(name)
    if type(name) ~= "string" then return nil end
    return UNIT_LIMITS[name:lower()] or mc.limits[name]
end

local function countName(name)
    local n = 0
    for _, nm in pairs(mc.id2name) do
        if nm == name then n = n + 1 end
    end
    return n
end

local function upgradeWait()
    local ok, ping = pcall(function() return lp:GetNetworkPing() end)
    if not ok or type(ping) ~= "number" then ping = 0.1 end
    return math.clamp(ping * 4 + 0.5, 0.8, 1.6)
end

-- known price: wait for exactly that balance. unknown or stale price: retry on small
-- income steps (2% of the recorded balance) instead of an ever-growing backoff, which
-- used to overshoot the price and stall until the next wave payout
local function waitAffordable(s, myMatch)
    local now = money()
    local need
    if s.c and s.c > now then
        need = s.c
    else
        need = now + math.max(1, math.floor((s.m or 0) * 0.02))
    end
    if not waitUntil(function() return money() >= need end, math.huge, myMatch, 0.05) then return false end
    return sleep(0.3, myMatch)
end

-- passive income landing before the charge can only make a measured drop smaller than the real
-- price, so a measurement may raise the stored price; it may lower it only when the action
-- succeeded with less money than the stored price (proof that the price is stale)
local function keepPrice(s, c, m0)
    if c <= 0 then return end
    local raise = not s.c or c > s.c + math.max(10, s.c * 0.1)
    local stale = s.c and m0 and m0 < s.c and c < s.c
    if raise or stale then
        s.c = c
        mc.learned = true
    end
end

local function doPlace(s, myMatch)
    local p = a2v(s.p)
    if idAt(p) then return true end
    if ownCount() >= MAX_UNITS then
        flash("Unit limit reached (" .. MAX_UNITS .. "), step skipped", "Warning")
        return false
    end
    local lim = limitFor(s.n)
    if lim and countName(s.n) >= lim then
        flash(tostring(s.n) .. " limit (" .. lim .. ") reached, step skipped", "Warning")
        return false
    end
    local unitId = resolveUnit(s.n, s.u)
    local misses = 0
    while same(myMatch) do
        if idAt(p) then return true end
        if s.c and money() < s.c then
            waitUntil(function() return money() >= s.c end, 45, myMatch, 0.05)
            if not same(myMatch) then return false end
        end
        local m0 = money()
        mc.waitPlace, mc.waitPlaceOk, mc.placeFail = p, false, nil
        R.TowerAdd:FireServer({Pos = p, CFrame = CFrame.new(p), Name = s.n, UnitId = unitId})
        waitUntil(function() return mc.waitPlaceOk or mc.placeFail ~= nil end, 1.5, myMatch, 0.02)
        local ok, fail = mc.waitPlaceOk, mc.placeFail
        mc.waitPlace = nil
        if ok then
            local lo = m0
            waitUntil(function()
                local mn = money()
                if mn < lo then lo = mn end
                return lo < m0
            end, 0.5, myMatch, 0.02)
            keepPrice(s, m0 - lo, m0)
            return true
        end
        if not same(myMatch) then return false end
        if fail == "limit" then
            local n = countName(s.n)
            if n > 0 then mc.limits[s.n] = n end
            flash(tostring(s.n) .. " limit reached, step skipped", "Warning")
            return false
        elseif fail == "money" then
            if not waitAffordable(s, myMatch) then return false end
        else
            misses = misses + 1
            if misses >= 6 then
                flash("Place failed, step skipped", "Warning")
                return false
            end
            if not sleep(0.6, myMatch) then return false end
        end
    end
    return false
end

local function doUpgrade(s, myMatch)
    local p = a2v(s.p)
    local silent = 0
    while same(myMatch) do
        local id = idAt(p)
        if not id then return false end
        if s.c and money() < s.c then
            waitUntil(function() return money() >= s.c end, 45, myMatch, 0.05)
            if not same(myMatch) then return false end
        end
        mc.upFail = false
        local before = mc.upAck[id]
        local m0 = money()
        local lo = m0
        R.TowerUpgrade:FireServer({Id = id})
        local outcome = "silent"
        local t0, window = os.clock(), upgradeWait()
        while same(myMatch) and os.clock() - t0 < window do
            if mc.upFail then
                outcome = "fail"
                break
            end
            local mn = money()
            if mn < lo then lo = mn end
            if lo < m0 or mc.upAck[id] ~= before then
                outcome = "ok"
                break
            end
            task.wait(0.02)
        end
        if not same(myMatch) then return false end
        if outcome == "ok" then
            keepPrice(s, m0 - lo, m0)
            return true
        elseif outcome == "silent" then
            -- once the game has acked upgrades, no ack and no money drop means it did not happen
            if not mc.ackSeen or silent >= 3 then return true end
            silent = silent + 1
            if waitUntil(function() return mc.upAck[id] ~= before or money() < m0 end, 1.0, myMatch, 0.02) then
                return true
            end
            if not same(myMatch) then return false end
        else
            if not waitAffordable(s, myMatch) then return false end
        end
    end
    return false
end

local function doSell(s, myMatch)
    for _ = 1, 3 do
        local id = idAt(a2v(s.p))
        if not id then return false end
        R.TowerSell:FireServer({Id = id})
        if waitUntil(function() return mc.id2pos[id] == nil end, 1.5, myMatch, 0.02) then return true end
        if not same(myMatch) then return false end
    end
    return false
end

local function doTarget(s, myMatch)
    local id = idAt(a2v(s.p))
    if not id then return false end
    for _ = 1, #TARGETS do
        if mc.id2mode[id] == s.mode then return true end
        local cur = mc.id2mode[id]
        R.TowerTarget:FireServer({Id = id})
        if not waitUntil(function() return mc.id2mode[id] ~= cur end, 1.0, myMatch, 0.02) then
            return false
        end
    end
    return false
end

local function gate(s, myMatch)
    if mc.replay == "Wave" or s.t == "sell" then
        if not waitUntil(function() return mc.wave >= (s.w or 0) end, math.huge, myMatch) then return false end
    end
    return same(myMatch)
end

local function runPlayback(myMatch)
    mc.playing = true
    mc.stepNo = 0
    local sel, steps = mc.selected, mc.steps
    for i, s in ipairs(mc.steps) do
        if not same(myMatch) then break end
        mc.stepNo = i
        if gate(s, myMatch) then
            if s.t == "place" then
                doPlace(s, myMatch)
            elseif s.t == "upgrade" then
                doUpgrade(s, myMatch)
            elseif s.t == "sell" then
                doSell(s, myMatch)
            elseif s.t == "target" then
                doTarget(s, myMatch)
            end
            task.wait(0.02)
        end
    end
    local finished = same(myMatch) and mc.stepNo >= #mc.steps
    mc.playing = false
    if mc.learned and sel and sel == mc.selected and steps == mc.steps then
        mc.learned = false
        if MAC.write(sel, {v = 2, replay = mc.replay, steps = mc.steps}) then
            flash("Macro calibrated: prices saved", "Success")
        end
    end
    if finished then flash("Macro finished, waiting for the next match", "Success") end
end

local function cleanSteps(arr)
    local out = {}
    if type(arr) ~= "table" then return out end
    for _, s in ipairs(arr) do
        if type(s) == "table" and type(s.t) == "string" and type(s.p) == "table"
            and type(s.p[1]) == "number" and type(s.p[2]) == "number" and type(s.p[3]) == "number" then
            table.insert(out, s)
        end
    end
    return out
end

local function refreshMacroList()
    if macroDD then macroDD:SetOptions(MAC.list()) end
end

local function loadMacro(name, silent)
    local d = MAC.read(name)
    local steps = d and cleanSteps(d.steps) or {}
    if #steps == 0 then
        if not silent then flash("Macro not found or empty: " .. tostring(name), "Error") end
        return false
    end
    mc.steps = steps
    if d.replay == "Money" or d.replay == "Wave" then
        mc.replay = d.replay
        if replayDD then replayDD:Set(d.replay, true) end
    end
    mc.selected = name
    MAC.setAuto(name)
    if macroDD then macroDD:Set(name, true) end
    if nameInput then nameInput:Set(name, true) end
    if not silent then flash("Loaded macro: " .. name .. " (" .. #steps .. " steps)", "Success") end
    return true
end

local function saveMacro()
    local n = sanitize(nameInput:Get())
    if n == "" then
        flash("Enter a macro name first", "Warning")
        return
    end
    if #mc.steps == 0 then
        flash("Nothing to save: record a macro first", "Warning")
        return
    end
    if MAC.write(n, {v = 2, replay = mc.replay, steps = mc.steps}) then
        mc.selected = n
        MAC.setAuto(n)
        refreshMacroList()
        macroDD:Set(n, true)
        flash("Saved macro: " .. n .. " (" .. #mc.steps .. " steps)", "Success")
    else
        flash("Save failed", "Error")
    end
end

local function deleteMacro()
    local n = sanitize(nameInput:Get())
    if n == "" then n = mc.selected or "" end
    if n == "" or not MAC.exists(n) then
        flash("Pick a saved macro to delete", "Warning")
        return
    end
    if MAC.delete(n) then
        if mc.selected == n then
            mc.selected = nil
            MAC.setAuto(nil)
        end
        refreshMacroList()
        macroDD:Set(nil, true)
        flash("Deleted macro: " .. n, "Success")
    else
        flash("Delete failed", "Error")
    end
end

local function nextMacroName()
    local n = 1
    while MAC.exists("macro #" .. n) do n = n + 1 end
    return "macro #" .. n
end

finishRecording = function(why)
    if not mc.rec then return end
    pcall(flushUpgrades)
    mc.pend, mc.queue, mc.settle = {}, {}, {}
    mc.rec = false
    syncToggles()
    if #mc.steps == 0 then
        flash(why .. ": nothing was recorded", "Warning")
        return
    end
    if mc.autoSave == false then
        flash(why .. ": recording stopped, " .. #mc.steps .. " steps kept (press Save)")
        return
    end
    local name = sanitize(nameInput and nameInput:Get() or "")
    if name == "" then name = nextMacroName() end
    if MAC.write(name, {v = 2, replay = mc.replay, steps = mc.steps}) then
        mc.selected = name
        MAC.setAuto(name)
        refreshMacroList()
        if macroDD then macroDD:Set(name, true) end
        if nameInput then nameInput:Set(name, true) end
        flash(why .. ": macro saved as " .. name .. " (" .. #mc.steps .. " steps)", "Success")
    else
        flash("Auto-save failed", "Error")
    end
end

