local SCRIPT_URL = "https://raw.githubusercontent.com/ricelp8-coder/diamondHub/main/huh" -- raw link to this script; empty = use the workspace file below
local SCRIPT_FILE = "diamond_hub.lua"  -- fallback: copy of this script inside the executor's workspace folder
local AE = {queued = false}
function AE.code()
    local load
    if SCRIPT_URL ~= "" then
        load = ("loadstring(game:HttpGet(%q))()"):format(SCRIPT_URL)
    elseif type(readfile) == "function" and type(isfile) == "function" and isfile(SCRIPT_FILE) then
        load = ("loadstring(readfile(%q))()"):format(SCRIPT_FILE)
    else
        return nil, "set SCRIPT_URL or put diamond_hub.lua into workspace"
    end
    return "if not game:IsLoaded() then game.Loaded:Wait() end "
        .. "if getgenv().cm_ae_off then return end getgenv().cm_ae = true " .. load
end
function AE.queue()
    local q = (type(queue_on_teleport) == "function" and queue_on_teleport)
        or (type(syn) == "table" and type(syn.queue_on_teleport) == "function" and syn.queue_on_teleport)
        or (type(fluxus) == "table" and type(fluxus.queue_on_teleport) == "function" and fluxus.queue_on_teleport)
    if not q then return false, "no queue_on_teleport in this executor" end
    if AE.queued then return true end
    local code, why = AE.code()
    if not code then return false, why end
    if not pcall(q, code) then return false, "queue_on_teleport failed" end
    AE.queued = true
    return true
end

