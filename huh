local function init()
    task.spawn(function()
        local ls = lp:WaitForChild("leaderstats", 30)
        ctx.mv = ls and ls:WaitForChild("Money", 30)
    end)

    local ev, fn
    while alive() do
        local ml = RS:FindFirstChild("ModuleLoader")
        local sh = ml and ml:FindFirstChild("Shared")
        local net = sh and sh:FindFirstChild("Network")
        ev = net and net:FindFirstChild("RemoteEvent")
        fn = net and net:FindFirstChild("RemoteFunction")
        if ev and fn then break end
        setBase("Waiting for game remotes...")
        task.wait(1)
    end
    if not alive() then return end

    local okLobby, errLobby = pcall(LB.init, ev, fn)
    if not okLobby then warn("[cm] lobby: " .. tostring(errLobby)) end

    for _, n in ipairs({"ModeVote", "Notificate", "WaveSkip", "PlayAgain"}) do
        R[n] = ev:WaitForChild(n, 10)
        if not R[n] then
            setBase("Missing remote: " .. n)
            return
        end
    end
    R.ChangeSpeed = fn:WaitForChild("ChangeSpeed", 10)
    if cfg.autoSpeed then setSpeed(cfg.speed) end
    R.OnLeave = ev:FindFirstChild("OnLeave") or fn:FindFirstChild("OnLeave")
    R.Notificate.OnClientEvent:Connect(onNotify)

    -- separate thread: these waits can last 10s each and must not delay vote/speed/skip below
    task.spawn(function()
        local macroOk = true
        for _, n in ipairs({"TowerAdd", "TowerUpgrade", "TowerSell", "TowerTarget", "TowerRemove"}) do
            R[n] = ev:FindFirstChild(n) or ev:WaitForChild(n, 10)
            if not R[n] then macroOk = false end
        end
        mc.ok = macroOk
        if macroOk then
            R.TowerAdd.OnClientEvent:Connect(onTowerAdd)
            R.TowerRemove.OnClientEvent:Connect(onTowerRemove)
            R.TowerTarget.OnClientEvent:Connect(onTowerTarget)
            R.TowerUpgrade.OnClientEvent:Connect(onTowerUpgrade)
            mc.hook = installHook()
            if not mc.hook then flash("No hookmetamethod: macro recording disabled", "Warning") end
        else
            flash("Macro disabled: missing game remotes", "Error")
        end
        mc.initDone = true
        if not macroOk and mc.play then
            mc.play = false
            syncToggles()
        end
    end)

    task.spawn(function()
        while alive() do
            task.wait(0.1)
            if cfg.autoSkip and st.waveOn and os.clock() >= st.nextSkip then
                local lim = cfg.skipLimit or 0
                if lim > 0 and mc.wave >= lim then
                    -- wave N == limit: skipping would push N -> N+1, so leave it to the player (boss waves)
                    if st.limMatch ~= mc.matchId then
                        st.limMatch = mc.matchId
                        flash("Auto Skip stopped: wave limit " .. lim .. " reached", "Warning")
                    end
                else
                    R.WaveSkip:FireServer()
                    st.nextSkip = os.clock() + cfg.skipRepeat
                end
            end
        end
    end)

    task.spawn(function()
        while alive() do
            task.wait(0.1)
            local ok1, e1 = pcall(drainQueue)
            if not ok1 then warn("[cm] drain: " .. tostring(e1)) end
            local ok2, e2 = pcall(tickPend)
            if not ok2 then warn("[cm] pend: " .. tostring(e2)) end

            if mc.ok and mc.play and not mc.running and #mc.steps > 0
                and mc.ranMatch ~= mc.matchId and not st.inVote and not mc.finalSeen then
                mc.ranMatch = mc.matchId
                mc.running = true
                local myMatch = mc.matchId
                task.spawn(function()
                    local ok, err = pcall(runPlayback, myMatch)
                    if not ok then
                        flash("Macro error: " .. tostring(err):sub(1, 40), "Error")
                        warn("[cm] macro: " .. tostring(err))
                    end
                    mc.playing = false
                    mc.running = false
                end)
            end
        end
    end)

    task.spawn(function()
        local n = 0
        while alive() do
            task.wait(0.1)
            n = n + 1
            if votingOpen() then
                if not st.inVote then
                    st.inVote, st.voted = true, false
                    st.voteTries = 0
                    newMatch()
                end
                st.finalShown = false
                if cfg.autoVote then
                    -- vote the instant the screen opens; re-send up to 3 times in case the server wasn't ready
                    local now = os.clock()
                    if not st.voted or ((st.voteTries or 0) < 3 and now - (st.voteLast or 0) > 1.5) then
                        st.voted = true
                        st.voteTries = (st.voteTries or 0) + 1
                        st.voteLast = now
                        st.matchMode = cfg.mode
                        R.ModeVote:FireServer(cfg.mode)
                    end
                end
            else
                st.inVote = false
                if finalOpen() then
                    matchEnded()
                    if not st.reportStarted then
                        st.reportStarted = true
                        if cfg.report then startReport() end
                    end
                    if (cfg.autoLeave or cfg.autoPlayAgain) and not st.finalShown then
                        st.finalShown = true
                        task.delay(cfg.autoLeave and cfg.leaveDelay or cfg.playAgainDelay, function()
                            if not alive() then return end
                            local since = os.clock()
                            while st.reportBusy and alive() and os.clock() - since < 4 do task.wait(0.05) end
                            if cfg.autoLeave then
                                fireLeave()
                            elseif cfg.autoPlayAgain then
                                R.PlayAgain:FireServer()
                            end
                        end)
                    end
                else
                    st.finalShown = false
                end
            end

            if cfg.autoSpeed and st.curSpeed ~= cfg.speed and R.ChangeSpeed and (st.speedTries or 0) < 5
                and os.clock() - (st.speedLast or 0) > 2 then
                st.speedTries = (st.speedTries or 0) + 1
                st.speedLast = os.clock()
                setSpeed(cfg.speed)
            elseif st.curSpeed == cfg.speed then
                st.speedTries = 0
            end

            if n % 10 == 0 then
                setBase(string.format("Ready\nWave %d | x%s", mc.wave, st.curSpeed and tostring(st.curSpeed) or "?"))

                local line
                if mc.running then
                    line = string.format("PLAYING %d/%d", mc.stepNo, #mc.steps)
                elseif mc.play then
                    line = "ARMED (waits for a match)"
                elseif mc.rec then
                    line = "RECORDING"
                else
                    line = "idle"
                end
                macroStatus:SetText(string.format("steps <b>%d</b> | wave <b>%d</b> | $<b>%d</b>\n%s",
                    #mc.steps, mc.wave, math.floor(money()), line))
            end
        end
    end)

    refreshMacroList()
    setBase("Ready")
end

