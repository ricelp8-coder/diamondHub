    mc.queue = {}
    for _, e in ipairs(q) do
        if e.k == "TowerAdd" then
            if typeof(e.pos) == "Vector3" then
                table.insert(mc.pend, {k = "place", p = e.pos, u = e.u, n = e.n, m = e.m, lo = e.lo, w = e.w, ts = e.ts})
            end
        else
            local p = e.id and mc.id2pos[e.id]
            if p then
                table.insert(mc.pend, {
                    k = (e.k == "TowerUpgrade") and "upgrade" or "sell",
                    p = p, id = e.id, m = e.m, lo = e.lo, w = e.w, ts = e.ts,
                })
            else
                flash("Unknown tower: place towers after the script starts", "Warning")
            end
        end
    end
end

-- an upgrade is real only if the server acked it (TowerUpgrade event) or, when this
-- game never acks, if the balance actually dropped after the click
local function upgradeConfirmed(e)
    if e.ok then return true end
    return not mc.ackSeen and e.lo ~= nil and e.m ~= nil and e.lo < e.m
end

local function tickPend()
    local now = os.clock()
    for i = #mc.pend, 1, -1 do
        local e = mc.pend[i]
        local age = now - e.ts
        if e.k == "upgrade" then
            if age > 0.8 and upgradeConfirmed(e) then
                table.remove(mc.pend, i)
                pushStep({t = "upgrade", p = v2a(e.p), m = e.m, c = priceOf(e), w = e.w, ts = e.ts})
            elseif age > 3 then
                table.remove(mc.pend, i)
            end
        elseif age > 6 then
            table.remove(mc.pend, i)
            if e.k == "place" then flash("Placement rejected, not recorded", "Warning") end
        end
    end
    for i = #mc.settle, 1, -1 do
        local e = mc.settle[i]
        if now - e.ts > 0.8 then
            table.remove(mc.settle, i)
            local c = priceOf(e, e.step)
            if c then e.step.c = c end
        end
    end
end

local function flushUpgrades()
    drainQueue()
    for i = #mc.pend, 1, -1 do
        local e = mc.pend[i]
        if e.k == "upgrade" and upgradeConfirmed(e) then
            table.remove(mc.pend, i)
            pushStep({t = "upgrade", p = v2a(e.p), m = e.m, c = priceOf(e), w = e.w, ts = e.ts})
        end
    end
end

local function dropLastUpgrade()
    for i = #mc.pend, 1, -1 do
        local e = mc.pend[i]
        if e.k == "upgrade" and not e.ok and os.clock() - e.ts < 2 then
            table.remove(mc.pend, i)
            return
        end
    end
end

