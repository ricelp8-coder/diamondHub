                {"delfile", fn(delfile)}, {"isfolder", fn(isfolder)}, {"makefolder", fn(makefolder)},
            },
            test = filesWork,
            hint = "Everything is kept only until you leave the game",
        },
        {
            label = "Clipboard",
            funcs = {{"setclipboard", clipboardOk}},
            hint = "Copy buttons show the text instead",
        },
    }

