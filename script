local Releases = {
    [10762636904] = {Release = "Cameraman_TD", Folder = "CameraTD_Macros", RequiresCache = true},
    [10393438342] = {Release = "Alliance_TD", Folder = "AllianceTD_Macros", RequiresCache = true},
}
local BaseURL = "https://raw.githubusercontent.com/ricelp8-coder/Sources/main/"
if not game:IsLoaded() then game.Loaded:Wait() end
local release = Releases[game.GameId]
if not release then error("Diamond Hub: unsupported game.", 0) end
local env = getgenv()
local url = BaseURL .. release.Release
env.__DiamondLoaderBusy = env.__DiamondLoaderBusy or {}
if env.__DiamondLoaderBusy[url] then return end
env.__DiamondLoaderBusy[url] = true
local ok, reason = pcall(function()
    local source = game:HttpGet(url)
    local run, compileError = loadstring(source, "DiamondHubRelease")
    if not run then error(compileError, 0) end
    local hasFiles = type(isfolder) == "function"
        and type(makefolder) == "function" and type(writefile) == "function"
    if release.RequiresCache and not hasFiles then
        error("Diamond Hub: file APIs are required for Auto Execute.", 0)
    end
    if hasFiles then
        if not isfolder(release.Folder) then makefolder(release.Folder) end
        writefile(release.Folder .. "/Hub.lua", source)
    end
    run()
end)
env.__DiamondLoaderBusy[url] = nil
if not ok then error(reason, 0) end
