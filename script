local Releases = {
    [10762636904] = {Release = "Cameraman_TD", Folder = "CameraTD_Macros", RequiresCache = true},
    [2440500124] = {Release = "Doors", Folder = "DiamondHub_Doors", RequiresCache = false},
    [4938220315] = {Release = "Skibi_TD", Folder = "SkibiTD", RequiresCache = true},
}
local BaseURL = "https://raw.githubusercontent.com/ricelp8-coder/koch/main/"
local function say(msg)
    print("[DiamondHub] " .. tostring(msg))
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {Title = "Diamond Hub", Text = tostring(msg):sub(1, 180), Duration = 8})
    end)
end
if not game:IsLoaded() then game.Loaded:Wait() end
local release = Releases[game.GameId]
if not release then
    say("unsupported game (GameId " .. tostring(game.GameId) .. ")")
    return
end
local env = getgenv()
local url = BaseURL .. release.Release
env.__DiamondLoaderBusy = env.__DiamondLoaderBusy or {}
local started = env.__DiamondLoaderBusy[url]
if started and os.clock() - started < 120 then
    say("already loading, wait a moment")
    return
end
env.__DiamondLoaderBusy[url] = os.clock()
local ok, reason = pcall(function()
    local source = game:HttpGet(url)
    local run, compileError = loadstring(source, "DiamondHubRelease")
    if not run then error("compile error: " .. tostring(compileError), 0) end
    local hasFiles = type(isfolder) == "function"
        and type(makefolder) == "function" and type(writefile) == "function"
    if release.RequiresCache and not hasFiles then
        error("file APIs are required for Auto Execute", 0)
    end
    if hasFiles then
        pcall(function()
            if not isfolder(release.Folder) then makefolder(release.Folder) end
            writefile(release.Folder .. "/Hub.lua", source)
        end)
    end
    env.__DiamondLoaderBusy[url] = nil
    task.spawn(run)
end)
if not ok then
    env.__DiamondLoaderBusy[url] = nil
    say("loader failed: " .. tostring(reason))
    error(reason, 0)
end
